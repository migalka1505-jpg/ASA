window.addEventListener("resize", function() {
  clearTimeout(_resizeTimer);
  _resizeTimer = setTimeout(function() {
    autoSwitchCatalogView();
    updateMobileCloseBtn();
  }, 250);
});
/* Свайп вниз для модалок */
(function() {
  var startY = 0, currentModal = null, startTime = 0;
  document.addEventListener("touchstart", function(e) {
    if (window.innerWidth > 700) return;
    var modal = e.target.closest(".modal");
    if (!modal || modal.classList.contains("game-modal")) return;
    var scrollable = e.target.closest(".compare-wrap, .ar-view, .game-screen");
    if (scrollable && scrollable.scrollTop > 0) return;
    startY = e.touches[0].clientY;
    startTime = Date.now();
    currentModal = modal;
  }, { passive: true });
  document.addEventListener("touchmove", function(e) {
    if (!currentModal) return;
    var dy = e.touches[0].clientY - startY;
    if (dy > 10) {
      currentModal.style.transition = "none";
      currentModal.style.transform = "translateY(" + dy + "px)";
    }
  }, { passive: true });
  document.addEventListener("touchend", function(e) {
    if (!currentModal) return;
    var dy = e.changedTouches[0].clientY - startY;
    var dt = Date.now() - startTime;
    if (dy > 100 && dt < 500) {
      currentModal.style.transition = "transform 0.25s ease";
      currentModal.style.transform = "translateY(100%)";
      var m = currentModal;
      setTimeout(function() {
        mobileClose();
        m.style.transform = "";
        m.style.transition = "";
      }, 250);
    } else {
      currentModal.style.transition = "transform 0.25s ease";
      currentModal.style.transform = "translateY(0)";
      setTimeout(function() {
        if (currentModal) { currentModal.style.transition = ""; currentModal.style.transform = ""; }
      }, 250);
    }
    currentModal = null; startY = 0;
  }, { passive: true });
})();

