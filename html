function scorePrice(p) {
  if (!window._pb) {
    var mn = Infinity, mx = -Infinity;
    for (var i = 0; i < components.length; i++) {
      if (components[i].price < mn) mn = components[i].price;
      if (components[i].price > mx) mx = components[i].price;
    }
    window._pb = { mn: mn, mx: mx };
  }
  var b = window._pb;
  if (b.mx === b.mn) return 100;
  return Math.round(100 - ((p - b.mn) / (b.mx - b.mn)) * 100);
}
function scoreDelivery(v) { var d = getDeliveryDays(v); return d <= 1 ? 100 : d >= 60 ? 0 : Math.round(100 - ((d - 1) / 59) * 100); }
function scoreVendor(v) { var x = vendorDatabase[v]; return x ? (x.tier === 1 ? 100 : x.tier === 2 ? 75 : 50) : 50; }
function scoreCountry(v) { var x = vendorDatabase[v]; if (!x) return 50; return ({RU:100,EU:80,US:70,JP:75,CN:60})[x.country] || 50; }
function scoreStock(s) { return s ? 100 : 40; }
function scoreReliability(v) { var x = vendorDatabase[v]; return x ? x.reliability : 50; }
function classMatchBonus(c) {
  var any = false;
  for (var k in selectedClasses) if (selectedClasses[k]) { any = true; break; }
  if (!any) return 0;
  if (selectedClasses[c.category + "/" + c.subcategory]) return 12;
  if (selectedClasses[c.category]) return 6;
  return 0;
}
function matchesSelectedClasses(c) {
  var any = false;
  for (var k in selectedClasses) if (selectedClasses[k]) { any = true; break; }
  if (!any) return true;
  return !!(selectedClasses[c.category + "/" + c.subcategory] || selectedClasses[c.category]);
}
function calculateScore(c) {
  var w = smartWeights;
  var s = {
    price: scorePrice(c.price), delivery: scoreDelivery(c.vendor),
    vendor: scoreVendor(c.vendor), country: scoreCountry(c.vendor),
    stock: scoreStock(c.stock), reliability: scoreReliability(c.vendor),
    eco: Math.round(100 - Math.min(100, getComponentEco(c) * 5)),
    import: getComponentImportIndex(c),
    twin: 60 + ((c.id * 13) % 40)
  };
  var total = w.price + w.delivery + w.vendor + w.country + w.stock + w.reliability + w.eco + w.import + w.twin;
  if (total === 0) total = 100;
  var base = (s.price*w.price + s.delivery*w.delivery + s.vendor*w.vendor + s.country*w.country +
             s.stock*w.stock + s.reliability*w.reliability + s.eco*w.eco + s.import*w.import + s.twin*w.twin) / total;
  return { total: Math.min(Math.round(base + classMatchBonus(c)), 100), breakdown: s };
}
function getScoreClass(s) { return s>=85?"score-perfect":s>=70?"score-good":s>=55?"score-ok":"score-low"; }
function renderScoreBreakdown() {
  var w = smartWeights;
  var total = w.price+w.delivery+w.vendor+w.country+w.stock+w.reliability+w.eco+w.import+w.twin;
  if (total === 0) total = 100;
  return '<div class="score-breakdown">' +
    '<div class="score-breakdown-bar sbd-price" style="width:' + (w.price/total*100) + '%"></div>' +
    '<div class="score-breakdown-bar sbd-delivery" style="width:' + (w.delivery/total*100) + '%"></div>' +
    '<div class="score-breakdown-bar sbd-vendor" style="width:' + (w.vendor/total*100) + '%"></div>' +
    '<div class="score-breakdown-bar sbd-country" style="width:' + (w.country/total*100) + '%"></div>' +
    '<div class="score-breakdown-bar sbd-stock" style="width:' + (w.stock/total*100) + '%"></div>' +
    '<div class="score-breakdown-bar sbd-reliability" style="width:' + (w.reliability/total*100) + '%"></div>' +
  '</div>';
}
