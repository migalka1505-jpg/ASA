  if (days <= 3) { mn = 1; mx = 2; } else if (days <= 7) { mn = 1; mx = 3; }
  else if (days <= 14) { mn = 2; mx = 4; } else if (days <= 21) { mn = 3; mx = 5; }
  else { mn = 4; mx = 5; }
  return { min: mn, max: mx, exact: days };
}
