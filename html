    border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--orange));
    color:#0A0A0C; font-size:1.9rem; display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 40px rgba(255,210,0,.55); z-index:800; cursor:pointer;
    transition:all .4s; animation:pulseRing 2.5s infinite; line-height:1; }
  .assistant-fab:hover { transform:scale(1.15) rotate(-10deg); }
  .assistant-fab .ai-dot { position:absolute; top:6px; right:6px; width:14px; height:14px;
    border-radius:50%; background:var(--green); border:2px solid var(--surface); }
  .assistant-panel { position:fixed; bottom:105px; left:24px; width:470px; max-width:calc(100vw - 48px);
    height:720px; max-height:calc(100vh - 130px); background:var(--surface);
    border:1px solid rgba(255,255,255,.08); border-radius:22px;
    box-shadow:var(--shadow-lg); z-index:850; display:none; flex-direction:column; overflow:hidden; }
  .assistant-panel.active { display:flex; animation:popIn .4s; }
  .assistant-header { padding:18px 22px; background:linear-gradient(135deg,#0A0A0C,#1a1a24);
    color:var(--gold); display:flex; justify-content:space-between; align-items:center;
    border-bottom:2px solid var(--gold); }
  .assistant-title { display:flex; align-items:center; gap:14px; font-weight:700; font-size:.95rem; }
  .assistant-avatar { width:46px; height:46px; background:linear-gradient(135deg,var(--gold),var(--orange));
    display:flex; align-items:center; justify-content:center; font-size:1.5rem;
    animation:morphBlob 6s ease-in-out infinite; flex-shrink:0; line-height:1; }
  .assistant-title-text { display:flex; flex-direction:column; line-height:1.2; }
  .assistant-title-text .name { font-size:1rem; font-weight:800; }
  .assistant-title-text small { font-size:.72rem; opacity:.85; display:flex; align-items:center; gap:5px; }
  .online-dot { width:7px; height:7px; border-radius:50%; background:#10B981; animation:blink 1.5s infinite; }
  .assistant-header-btns { display:flex; gap:6px; }
  .assistant-header-btn { background:rgba(255,210,0,.15); border:none; color:var(--gold);
    width:32px; height:32px; border-radius:8px; cursor:pointer; display:flex;
    align-items:center; justify-content:center; font-size:.9rem; line-height:1; }
  .assistant-header-btn:hover { background:rgba(255,210,0,.3); }
  .assistant-messages { flex:1; overflow-y:auto; padding:22px; display:flex; flex-direction:column; gap:16px; background:var(--bg); }
  .quick-cmds { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:16px; }
  .quick-cmd { padding:14px 8px; background:var(--glass); border:1px solid var(--border-hi);
    border-radius:12px; text-align:center; cursor:pointer; transition:all .3s; color:var(--text-2); }
  .quick-cmd:hover { border-color:var(--gold); background:rgba(255,210,0,.08); transform:translateY(-3px); }
  .quick-cmd .qc-icon { font-size:1.4rem; display:block; margin-bottom:6px; }
  .quick-cmd .qc-text { font-size:.72rem; font-weight:600; }
  .msg { max-width:88%; padding:14px 18px; border-radius:18px; font-size:.88rem; line-height:1.55;
    word-wrap:break-word; position:relative; animation:slideInLeft .35s; }
  .msg.user { align-self:flex-end; background:linear-gradient(135deg,var(--gold),#E5BD00); color:#0A0A0C;
    border-bottom-right-radius:4px; font-weight:500; animation:slideInRight .35s; }
  .msg.bot { align-self:flex-start; background:var(--surface-2); border:1px solid var(--border-hi); border-bottom-left-radius:4px; }
  .msg.bot::before { content:"🤖"; position:absolute; top:-10px; left:-10px; width:28px; height:28px;
    background:linear-gradient(135deg,var(--gold),var(--orange)); border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-size:.8rem; }
  .msg.bot.denied { background:rgba(239,68,68,.08); border-color:rgba(239,68,68,.4); }
  .msg strong { color:var(--gold); }
  .typing-dots { display:inline-flex; gap:4px; padding:4px 0; align-items:center; }
  .typing-dots span { width:6px; height:6px; border-radius:50%; background:var(--gold); animation:typingDot 1.4s infinite; }
  .typing-dots span:nth-child(2) { animation-delay:.2s; } .typing-dots span:nth-child(3) { animation-delay:.4s; }
  .quick-replies { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
  .quick-reply { padding:7px 14px; background:var(--glass); border:1px solid var(--border-hi);
    border-radius:16px; font-size:.76rem; color:var(--text-2); cursor:pointer; transition:all .3s; }
  .quick-reply:hover { border-color:var(--gold); color:var(--gold); }
  .assistant-input-wrap { padding:14px 16px; background:var(--surface); border-top:1px solid var(--border-hi);
    display:flex; gap:8px; align-items:flex-end; }
  .assistant-input { flex:1; background:var(--glass); border:1px solid var(--border-hi); border-radius:12px;
    padding:12px 16px; color:var(--text); font-size:.88rem; font-family:inherit; resize:none;
    max-height:100px; min-height:42px; }
  .assistant-input:focus { outline:none; border-color:var(--gold); }
  .assistant-icon-btn { width:42px; height:42px; border-radius:12px; background:var(--glass);
    color:var(--text-2); border:1px solid var(--border-hi); cursor:pointer; font-size:1rem; flex-shrink:0; line-height:1; }
  .assistant-icon-btn:hover { border-color:var(--gold); color:var(--gold); }
  .assistant-send { width:46px; height:46px; border-radius:12px; background:linear-gradient(135deg,var(--gold),#E5BD00);
    color:#0A0A0C; border:none; cursor:pointer; font-size:1.05rem; flex-shrink:0; line-height:1; }
  .assistant-send:hover { transform:scale(1.1) rotate(-5deg); }
  .assistant-send:disabled { opacity:.5; cursor:not-allowed; transform:none; }
  .assistant-footer { padding:8px 18px 12px; background:var(--surface); font-size:.72rem;
    color:var(--text-3); display:flex; justify-content:space-between; align-items:center; }

  /* ============ ИГРА ============ */
  .game-modal { max-width:720px !important; padding:0 !important; overflow:hidden !important; }
  .game-screen { position:relative; width:100%; height:560px; background:linear-gradient(180deg,#0F0F14 0%,#1a1a24 100%);
    overflow:hidden; touch-action:none; user-select:none; }
  .game-hud { position:absolute; top:0; left:0; right:0; padding:14px 20px; display:flex;
    justify-content:space-between; align-items:center; z-index:10;
    background:linear-gradient(180deg,rgba(0,0,0,.7),transparent); pointer-events:none; }
  .game-hud .hud-item { font-family:'JetBrains Mono',monospace; font-weight:800; font-size:.9rem; color:#F5F5F7;
    background:rgba(0,0,0,.5); padding:6px 14px; border-radius:20px; border:1px solid rgba(255,210,0,.4); }
  .game-hud .hud-item .val { color:var(--gold); }
  .game-item { position:absolute; font-size:2.4rem; cursor:pointer; will-change:transform;
    transition:transform .08s; -webkit-tap-highlight-color:transparent; touch-action:manipulation;
    filter:drop-shadow(0 4px 12px rgba(0,0,0,.5)); }
  .game-item:active { transform:scale(.85); }
  .game-item.bomb { filter:drop-shadow(0 0 12px rgba(239,68,68,.8)); }
  .game-item.rare { filter:drop-shadow(0 0 16px rgba(139,92,246,.9)); animation:bob .6s ease-in-out infinite; }
  .game-pop { position:absolute; font-family:'JetBrains Mono',monospace; font-weight:900;
    font-size:1.2rem; pointer-events:none; animation:popStar .6s forwards; z-index:20; }
  .game-over { position:absolute; inset:0; background:rgba(0,0,0,.88); backdrop-filter:blur(10px);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px;
    padding:30px; z-index:50; text-align:center; animation:fadeIn .3s; }
  .game-over h2 { font-size:1.8rem; background:linear-gradient(135deg,var(--gold),var(--orange));
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  .game-over .score-big { font-family:'JetBrains Mono',monospace; font-size:3.5rem; font-weight:900; color:var(--gold); }
  .game-over .badge-earned { padding:10px 20px; background:rgba(16,185,129,.15);
    border:1px solid rgba(16,185,129,.4); border-radius:12px; color:#6EE7B7; font-size:.9rem; font-weight:700; }
  .game-start { position:absolute; inset:0; background:rgba(0,0,0,.85); backdrop-filter:blur(10px);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px;
    padding:30px; z-index:50; text-align:center; }
  .game-start h2 { font-size:1.6rem; color:var(--gold); }
  .game-start p { color:var(--text-2); font-size:.88rem; max-width:400px; line-height:1.6; }
  .game-start .legend { display:flex; gap:16px; flex-wrap:wrap; justify-content:center; margin:8px 0; }
  .game-start .legend-item { display:flex; flex-direction:column; align-items:center; gap:4px; font-size:.72rem; color:var(--text-3); }
  .game-start .legend-item .ico { font-size:1.8rem; }

  /* ============ AR-МОДАЛ ============ */
  .ar-view { position:relative; width:100%; height:480px; background:#000; border-radius:14px; overflow:hidden; }
  .ar-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .ar-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; }
  .ar-model { font-size:9rem; filter:drop-shadow(0 10px 30px rgba(255,210,0,.6)); animation:bob 3s ease-in-out infinite;
    pointer-events:auto; cursor:move; }
  .ar-hud { position:absolute; bottom:0; left:0; right:0; padding:14px 20px;
    background:linear-gradient(0deg,rgba(0,0,0,.85),transparent); color:#fff;
    display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
  .ar-badge { background:rgba(16,185,129,.2); border:1px solid #10B981; color:#6EE7B7;
    padding:4px 12px; border-radius:16px; font-size:.72rem; font-weight:700; }
  .ar-crosshair { position:absolute; top:50%; left:50%; width:60px; height:60px;
    transform:translate(-50%,-50%); border:2px dashed rgba(255,210,0,.5); border-radius:50%; pointer-events:none; }

  /* ============ DASHBOARD ============ */
  .dashboard { display:none; } .dashboard.active { display:block; animation:fadeIn .4s; }
  .dashboard-header { display:flex; justify-content:space-between; align-items:center; padding:22px 28px;
    margin-bottom:22px; background:linear-gradient(135deg,#0A0A0C,#1a1a24); border:2px solid var(--gold);
    border-radius:18px; color:var(--gold); flex-wrap:wrap; gap:14px; }
  .dashboard-tabs { display:flex; gap:8px; margin-bottom:22px; background:var(--panel-bg);
    padding:6px; border-radius:12px; border:1px solid var(--border-hi); overflow-x:auto; }
  .dashboard-tab { padding:11px 20px; background:transparent; border:none; color:var(--text-2);
    font-weight:600; font-size:.88rem; border-radius:8px; cursor:pointer; font-family:inherit;
    white-space:nowrap; transition:all .3s; display:flex; align-items:center; gap:6px; }
  .dashboard-tab:hover { background:var(--glass); color:var(--text); }
  .dashboard-tab.active { background:linear-gradient(135deg,var(--gold),#E5BD00); color:#0A0A0C; }
  .tab-panel { display:none; } .tab-panel.active { display:block; animation:fadeInUp .35s; }

  .func-search { width:100%; padding:14px 18px; border-radius:12px; border:2px solid var(--border-hi);
    background:rgba(0,0,0,.35); color:var(--text); font-family:inherit; font-size:.95rem; margin-bottom:16px; }
  .func-search:focus { outline:none; border-color:var(--gold); }
  .func-groups { display:flex; flex-direction:column; gap:16px; }
  .func-group { background:var(--glass); border:1px solid var(--border-hi); border-radius:14px; padding:18px; }
  .func-group-title { font-weight:800; font-size:1rem; margin-bottom:12px;
    background:linear-gradient(135deg,var(--gold),var(--orange)); -webkit-background-clip:text;
    background-clip:text; -webkit-text-fill-color:transparent; }
  .func-row { display:grid; grid-template-columns:minmax(240px,320px) 1fr; gap:16px;
    padding:12px 14px; border-radius:10px; transition:background .2s; align-items:start; }
  .func-row:hover { background:rgba(255,210,0,.06); }
  .func-row + .func-row { border-top:1px solid var(--border); }
  .func-sign { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:.82rem;
    color:var(--gold); word-break:break-word; line-height:1.4; }
  .func-sign small { display:block; color:var(--text-3); font-weight:400; font-size:.72rem; margin-top:4px; }
  .func-info { font-size:.82rem; color:var(--text-2); line-height:1.55; }
  .func-info .returns { color:var(--green); font-family:'JetBrains Mono',monospace; font-size:.75rem; }
  .func-info .param { color:var(--cyan); font-family:'JetBrains Mono',monospace; font-size:.75rem; }
  .func-tag { display:inline-block; padding:2px 8px; border-radius:10px; background:rgba(139,92,246,.15);
    color:#C4B5FD; font-size:.65rem; font-weight:700; margin-right:6px; }

  .profile-cover { height:140px; border-radius:16px; margin-bottom:-60px;
    background:linear-gradient(135deg,rgba(255,210,0,.3),rgba(248,119,40,.2),rgba(139,92,246,.2)); }
  .profile-main-card { background:var(--glass); border:1px solid var(--border-hi); border-radius:16px;
    padding:30px 26px 26px; text-align:center; }
  .profile-avatar-wrap { position:relative; display:inline-block; margin-bottom:14px; }
  .profile-avatar-large { width:120px; height:120px; border-radius:50%;
    background:linear-gradient(135deg,var(--gold),var(--orange)); color:#0A0A0C;
    display:flex; align-items:center; justify-content:center;
    font-size:2.6rem; font-weight:800; background-size:cover; overflow:hidden;
    border:4px solid var(--surface); animation:avatarGlow 3s ease-in-out infinite; }
  .profile-avatar-large img { width:100%; height:100%; object-fit:cover; }
  .avatar-upload-btn { position:absolute; bottom:0; right:0; width:38px; height:38px;
    border-radius:50%; background:var(--gold); color:#0A0A0C; border:3px solid var(--surface);
    cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem; transition:all .3s; }
  .avatar-upload-btn:hover { transform:scale(1.15) rotate(15deg); }
  .profile-name-big { font-size:1.4rem; font-weight:800; margin-bottom:6px; }
  .profile-email { color:var(--text-3); font-size:.88rem; margin-bottom:10px; }
  .profile-position { font-size:.85rem; color:var(--text-2); margin-bottom:14px; }
  .profile-edit-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:20px; }
  .profile-edit-card { background:var(--glass); border:1px solid var(--border-hi); border-radius:16px; padding:24px; }
  .profile-edit-card h3 { font-size:1rem; font-weight:700; margin-bottom:18px; }
  .city-suggest { position:relative; }
  .city-suggest-list { position:absolute; top:100%; left:0; right:0; background:var(--surface);
    border:1px solid var(--border-hi); border-radius:10px; margin-top:4px; max-height:220px;
    overflow-y:auto; z-index:100; display:none; box-shadow:var(--shadow-lg); }
  .city-suggest-list.show { display:block; }
  .city-suggest-item { padding:10px 14px; cursor:pointer; font-size:.85rem; border-bottom:1px solid var(--border); }
  .city-suggest-item:hover { background:rgba(255,210,0,.1); color:var(--gold); }
  .city-badge { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:20px;
    background:rgba(255,210,0,.12); color:var(--gold); border:1px solid rgba(255,210,0,.3);
    font-size:.85rem; font-weight:600; }

  .stats-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; margin-bottom:20px; }
  .stat-box { background:var(--glass); border:1px solid var(--border); border-radius:12px; padding:16px; text-align:center; }
  .stat-box .value { font-size:1.7rem; font-weight:800; color:var(--gold); font-family:'JetBrains Mono',monospace; }
  .stat-box .label { font-size:.72rem; color:var(--text-3); text-transform:uppercase; margin-top:4px; }

  .cart-layout { display:grid; grid-template-columns:1fr 340px; gap:20px; }
  .cart-item { display:grid; grid-template-columns:68px 1fr auto auto auto; gap:16px; align-items:center;
    padding:18px; background:var(--glass); border:1px solid var(--border-hi); border-radius:14px; margin-bottom:12px; }
  .cart-item:hover { border-color:var(--gold); }
  .cart-item-img { width:68px; height:68px; background:var(--surface-2); border-radius:12px;
    display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:2.1rem; line-height:1; }
  .cart-item-info h4 { font-size:.92rem; font-weight:700; margin-bottom:4px; }
  .cart-item-info .meta { font-size:.75rem; color:var(--text-3); }
  .quantity-ctrl { display:flex; align-items:center; gap:6px; background:var(--glass);
    border:1px solid var(--border-hi); border-radius:10px; padding:4px; }
  .quantity-ctrl button { width:30px; height:30px; border-radius:8px; background:transparent;
    color:var(--text-2); border:none; cursor:pointer; font-size:1rem; font-weight:700; line-height:1; }
  .quantity-ctrl button:hover { background:var(--gold); color:#0A0A0C; }
  .quantity-ctrl .qty { min-width:32px; text-align:center; font-weight:700; font-family:'JetBrains Mono',monospace; }
  .cart-item-price { font-family:'JetBrains Mono',monospace; font-weight:700; font-size:1rem; color:var(--gold); text-align:right; min-width:100px; }
  .cart-item-remove { width:36px; height:36px; border-radius:10px; background:transparent; color:var(--text-3);
    border:1px solid transparent; cursor:pointer; font-size:1rem; line-height:1; }
  .cart-item-remove:hover { background:rgba(239,68,68,.15); color:var(--red); }
  .cart-summary { background:var(--glass); border:1px solid var(--border-hi); border-radius:16px; padding:24px;
    position:sticky; top:20px; height:fit-content; }
  .cart-summary h3 { font-size:1rem; font-weight:700; margin-bottom:18px; padding-bottom:14px; border-bottom:2px solid var(--gold); }
  .summary-row { display:flex; justify-content:space-between; padding:8px 0; font-size:.88rem; color:var(--text-2); }
  .summary-row.total { border-top:2px solid var(--border-hi); margin-top:12px; padding-top:16px;
    font-size:1.2rem; font-weight:800; }
  .summary-row.total span:last-child { color:var(--gold); font-family:'JetBrains Mono',monospace; }
  .cart-summary .btn { width:100%; justify-content:center; margin-top:16px; }

  .fav-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
  .fav-card { background:var(--glass); border:1px solid var(--border-hi); border-radius:14px; padding:16px; }
  .fav-card:hover { border-color:var(--gold); }
  .fav-card.priority-5 { border-left:4px solid #EF4444; } .fav-card.priority-4 { border-left:4px solid #F87728; }
  .fav-card.priority-3 { border-left:4px solid #FFD200; } .fav-card.priority-2 { border-left:4px solid #06B6D4; }
  .fav-card.priority-1 { border-left:4px solid #10B981; }
  .priority-stars { display:flex; gap:2px; cursor:pointer; font-size:1rem; }
  .priority-stars .star { color:var(--text-3); transition:all .2s; }
  .priority-stars .star.active { color:var(--gold); transform:scale(1.15); }
  .fav-card h4 { font-size:.9rem; font-weight:700; margin-bottom:6px; }
  .fav-card .vendor { font-size:.72rem; color:var(--text-3); margin-bottom:10px; }
  .fav-card .price { font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--gold); font-size:1rem; margin-bottom:10px; }
  .fav-card .actions { display:flex; gap:6px; }
  .fav-card .actions button { flex:1; justify-content:center; }
  .empty-state { text-align:center; padding:60px 20px; background:var(--glass);
    border:1px dashed var(--border-hi); border-radius:16px; color:var(--text-3); }
  .empty-state .icon { font-size:3rem; margin-bottom:14px; opacity:.5; }
  .empty-state h3 { font-size:1.1rem; margin-bottom:8px; color:var(--text-2); }
  .order-card { background:var(--glass); border:1px solid var(--border-hi); border-radius:14px; padding:20px; margin-bottom:14px; }
  .order-header { display:flex; justify-content:space-between; margin-bottom:14px; flex-wrap:wrap; gap:8px; }
  .order-number { font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--gold); font-size:.95rem; }
  .order-date { font-size:.78rem; color:var(--text-3); }
  .order-status { padding:5px 14px; border-radius:22px; font-size:.72rem; font-weight:700; }
  .order-status.new { background:rgba(255,210,0,.15); color:var(--gold); }
  .order-status.processing { background:rgba(248,119,40,.15); color:#FFB07A; }
  .order-status.delivered { background:rgba(16,185,129,.15); color:#6EE7B7; }
  .order-items { border-top:1px solid var(--border); padding-top:12px; }
  .order-item { display:flex; justify-content:space-between; padding:6px 0; font-size:.83rem; }
  .order-total { display:flex; justify-content:space-between; margin-top:12px; padding-top:12px;
    border-top:2px solid var(--border-hi); font-weight:800; }
  .order-total span:last-child { color:var(--gold); font-family:'JetBrains Mono',monospace; }

  .ai-settings-row { display:grid; grid-template-columns:180px 1fr; gap:12px; align-items:center; margin-bottom:12px; }
  .ai-settings-row label { font-size:.85rem; font-weight:600; color:var(--text-2); }
  .ai-settings-row input, .ai-settings-row select { width:100%; padding:10px 14px; background:var(--glass);
    border:1px solid var(--border-hi); border-radius:10px; color:var(--text); font-size:.88rem; font-family:inherit; }
  .ai-status { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:16px; font-size:.75rem; font-weight:700; }
