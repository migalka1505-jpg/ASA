function generateComponents() {
  var arr = [], id = 1;
  var cats = Object.keys(SUBCATS);
  var catIdx = 0;
  var vendors = Object.keys(VENDORS);
  // 1000+ компонентов: 9 категорий × ~112
  while (arr.length < 1080) {
    var cat = cats[catIdx % cats.length];
    var subs = SUBCATS[cat];
    var sub = subs[Math.floor(Math.random() * subs.length)];
    var v = vendors[Math.floor(Math.random() * vendors.length)];
    var vd = VENDORS[v];
    var proto = ALL_PROTOCOLS_ARR[Math.floor(Math.random() * ALL_PROTOCOLS_ARR.length)];
    var range = RANGES[Math.floor(Math.random() * RANGES.length)];
    var basePrice = { "Датчик":18000, "Контроллер":95000, "Модуль ввода-вывода":28000,
      "Привод":120000, "Интерфейс":65000, "Питание":42000, "Арматура":55000,
      "Аналитика":280000, "Связь":38000 }[cat] || 30000;
    var countryMul = {RU:1, EU:3.5, US:4, JP:3.8, CN:1.4}[vd.country] || 2;
    var tierMul = vd.tier === 1 ? 1.4 : 1;
    var price = Math.round(basePrice * countryMul * tierMul * (0.7 + Math.random() * 0.8) / 100) * 100;
    var acc = ["±0.075%","±0.1%","±0.25%","±0.5%","±1.0%"][Math.floor(Math.random() * 5)];
    var tmin = [-60, -40, -20, 0][Math.floor(Math.random() * 4)];
    var ip = [65, 66, 67, 68][Math.floor(Math.random() * 4)];
    var lifetime = 8 + Math.floor(Math.random() * 17);
    var stock = Math.random() > 0.35;
    var name = v + " " + sub + " " + (1000 + Math.floor(Math.random() * 8999)) +
      (cat === "Датчик" ? " (" + range + ")" : "");
    arr.push({
      id: id++, name: name, vendor: v, category: cat, subcategory: sub,
      protocol: proto, price: price, stock: stock, range: range, accuracy: acc,
      tempMin: tmin, ip: ip, lifetime: lifetime
    });
    if (id % cats.length === 0) catIdx++;
  }
  return arr;
}

function loadData() {
  return new Promise(function(resolve, reject) {
    fetch("data/components.json")
      .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then(function(data) {
        components = data.components || [];
        vendorDatabase = data.vendors || VENDORS;
        deliveryTimes = data.deliveryTimes || DELIVERY_TIMES;
        subcategoriesByCategory = data.subcategories || SUBCATS;
        categoryIcons = data.categoryIcons || CAT_ICONS;
        CATEGORIES = Object.keys(subcategoriesByCategory);
        var ps = {};
        components.forEach(function(c) { if (c.protocol) ps[c.protocol] = 1; });
        ALL_PROTOCOLS = Object.keys(ps).sort();
        if (data.cities) CITIES = data.cities;
        console.log("✅ Загружено " + components.length + " из JSON");
        resolve();
      })
