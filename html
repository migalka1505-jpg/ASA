  if (!terms.length) return true;
  var h = [c.name, c.category, c.subcategory, c.protocol, c.vendor].join(" ").toLowerCase();
  for (var i = 0; i < terms.length; i++) if (h.indexOf(terms[i]) < 0) return false;
  return true;
}

