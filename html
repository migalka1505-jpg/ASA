/* ============ НИЖНЯЯ НАВИГАЦИЯ ============ */
var _bottomNavCurrent = "main";
function bottomNavGo(tab) {
  if (!currentUser) return;
  if (tab === "main") { switchView("main"); _bottomNavCurrent = "main"; }
  else if (tab === "catalog") {
    switchView("main");
    setTimeout(function() {
      var catalog = document.querySelector(".panel.focus-keep");
      if (catalog) catalog.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 100);
    _bottomNavCurrent = "catalog";
  }
  else if (tab === "game") { openGame(); _bottomNavCurrent = "game"; }
  else if (tab === "cart") { openDashboard("cart"); _bottomNavCurrent = "cart"; }
  else if (tab === "profile") { openDashboard("profile"); _bottomNavCurrent = "profile"; }
  updateBottomNav();
  if (navigator.vibrate) navigator.vibrate(10);
}
function updateBottomNav() {
  document.querySelectorAll(".bottom-nav-item").forEach(function(item) {
    item.classList.toggle("active", item.dataset.nav === _bottomNavCurrent);
  });
  var badge = $("bnCartBadge");
  if (badge) {
    var total = 0;
    cart.forEach(function(x) { total += x.qty; });
    if (total > 0) {
      badge.textContent = total > 99 ? "99+" : total;
      badge.classList.add("show");
    } else badge.classList.remove("show");
  }
}

/* ============ УНИВЕРСАЛЬНЫЙ КРЕСТИК ============ */
function updateMobileCloseBtn() {
  var body = document.body;
  var hasOverlay = false;
  var overlayType = "";
  if (document.querySelector(".modal-overlay.active")) { hasOverlay = true; overlayType = "modal"; }
  if (assistantOpen) { hasOverlay = true; overlayType = overlayType || "assistant"; }
  var dash = $("dashboard");
  if (dash && dash.classList.contains("active") && window.innerWidth <= 700) {
    hasOverlay = true; overlayType = overlayType || "cabinet";
  }
  body.classList.toggle("has-overlay", hasOverlay);
  body.classList.toggle("overlay-modal", overlayType === "modal");
  body.classList.toggle("overlay-assistant", overlayType === "assistant");
  body.classList.toggle("overlay-cabinet", overlayType === "cabinet");
}
function mobileClose() {
  var openModal = document.querySelector(".modal-overlay.active");
  if (openModal) {
    var id = openModal.id;
    if (id === "detailModal") closeDetailModal();
    else if (id === "analogModal") closeAnalogModal();
    else if (id === "compareModal") closeCompareModal();
    else if (id === "checkoutModal") closeCheckout();
    else if (id === "twinModal") closeTwinModal();
    else if (id === "ecoModal") closeEcoModal();
    else if (id === "blockchainModal") closeBlockchainModal();
    else if (id === "arModal") closeArModal();
    else if (id === "neuroModal") closeNeuroModal();
    else if (id === "onlineModal") closeOnlineModal();
    else if (id === "pwdModal") closePwdModal();
    else if (id === "gameModal") closeGame();
    else openModal.classList.remove("active");
    setTimeout(updateMobileCloseBtn, 50);
    return;
  }
  if (assistantOpen) { toggleAssistant(); return; }
  var dash = $("dashboard");
  if (dash && dash.classList.contains("active")) { switchView("main"); return; }
}

/* ============ АНИМАЦИЯ ФОНА ============ */
function initAurora() {
  var canvas = $("auroraCanvas");
  if (!canvas) return;
  var ctx = canvas.getContext("2d"), w, h;
  function resize() { w = canvas.width = innerWidth; h = canvas.height = innerHeight; }
  resize();
  addEventListener("resize", resize);
  var blobs = [];
  for (var i = 0; i < 6; i++) blobs.push({
    x: Math.random()*w, y: Math.random()*h,
    vx: (Math.random()-.5)*.3, vy: (Math.random()-.5)*.3,
    r: 200 + Math.random()*300,
    color: ["rgba(255,210,0,.15)","rgba(248,119,40,.12)","rgba(16,185,129,.10)",
      "rgba(139,92,246,.10)","rgba(6,182,212,.10)","rgba(236,72,153,.08)"][i]
  });
  (function draw() {
    ctx.clearRect(0, 0, w, h);
    blobs.forEach(function(b) {
      b.x += b.vx; b.y += b.vy;
      if (b.x < -b.r || b.x > w + b.r) b.vx *= -1;
      if (b.y < -b.r || b.y > h + b.r) b.vy *= -1;
      var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r);
      g.addColorStop(0, b.color); g.addColorStop(1, "transparent");
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI*2); ctx.fill();
    });
    requestAnimationFrame(draw);
  })();
}

/* ============ СОБЫТИЯ ============ */
function bindEvents() {
  document.querySelectorAll("th[data-sort]").forEach(function(th) {
    th.addEventListener("click", function() {
      var k = th.dataset.sort;
      if (sortKey === k) sortAsc = !sortAsc; else { sortKey = k; sortAsc = true; }
      if (sortByScore) { sortByScore = false; $("btnSortScore").textContent = "📊 Сортировать"; }
      render();
    });
  });
  var s = $("search"); if (s) s.addEventListener("input", function() { render(); autoSave(); });
  var cs = $("clearSearch"); if (cs) cs.addEventListener("click", function() { $("search").value = ""; render(); autoSave(); });
  ["protocol","tempMin","ipMin","filterPriceMax","filterCountry","subcategory",
   "filterDeliveryMax","filterEcoMax","filterImportMin","filterEnergyClass"].forEach(function(id) {
    var el = $(id);
    if (el) {
      el.addEventListener("input", function() { render(); autoSave(); });
      el.addEventListener("change", function() { render(); autoSave(); });
    }
  });
  var bi = $("projectBudgetInput");
  if (bi) { bi.addEventListener("input", updateBudget); bi.addEventListener("change", updateBudget); }
  ["detailModal","analogModal","compareModal","checkoutModal","twinModal","ecoModal",
   "blockchainModal","arModal","neuroModal","onlineModal","gameModal"].forEach(function(id) {
    var el = $(id); if (!el) return;
    el.addEventListener("click", function(e) {
      if (e.target.id !== id) return;
      if (id === "detailModal") closeDetailModal();
      else if (id === "analogModal") closeAnalogModal();
      else if (id === "compareModal") closeCompareModal();
      else if (id === "checkoutModal") closeCheckout();
      else if (id === "twinModal") closeTwinModal();
      else if (id === "ecoModal") closeEcoModal();
      else if (id === "blockchainModal") closeBlockchainModal();
      else if (id === "arModal") closeArModal();
      else if (id === "neuroModal") closeNeuroModal();
      else if (id === "onlineModal") closeOnlineModal();
      else if (id === "gameModal") closeGame();
    });
  });
  var pm = $("pwdModal"); if (pm) pm.addEventListener("click", function(e) { if (e.target.id === "pwdModal") closePwdModal(); });
  document.addEventListener("keydown", function(e) {
    // Alt+A — доступность
    if (e.altKey && (e.key === "a" || e.key === "A" || e.key === "ф" || e.key === "Ф")) {
      e.preventDefault(); toggleAccessibility(); return;
    }
    // Alt+T — тема
    if (e.altKey && (e.key === "t" || e.key === "T" || e.key === "е" || e.key === "Е")) {
      e.preventDefault(); toggleTheme(); return;
    }
    // Alt+G — игра
    if (e.altKey && (e.key === "g" || e.key === "G" || e.key === "п" || e.key === "П")) {
      e.preventDefault(); if (currentUser) openGame(); return;
    }
    if (e.key === "Escape") {
      if ($("pwdModal").classList.contains("active")) { closePwdModal(); return; }
      if (focusMode) { toggleFocus(); return; }
      closeDetailModal(); closeAnalogModal(); closeCompareModal();
      closeCheckout(); closeTwinModal(); closeEcoModal();
      closeBlockchainModal(); closeArModal(); closeNeuroModal();
      if (gameState.active) { endGame(); return; }
      if ($("gameModal").classList.contains("active")) closeGame();
    }
  });
  // Наблюдатель за модалками для body.modal-open
  var observer = new MutationObserver(function() {
    var anyOpen = document.querySelector(".modal-overlay.active");
    document.body.classList.toggle("modal-open", !!anyOpen);
    updateMobileCloseBtn();
  });
  observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });
}
/* Автопереключение вида на мобильном */
function isMobileScreen() { return window.innerWidth <= 700; }
function autoSwitchCatalogView() {
