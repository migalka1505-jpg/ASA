<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
<meta name="theme-color" content="#08080A" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F4F4F7" media="(prefers-color-scheme: light)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="format-detection" content="telephone=no">
<title>АСУТП 2026 · Нейро-база компонентов | Роснефть</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');

  :root, [data-theme="dark"] {
    --bg:#08080A; --bg-2:#101014; --surface:#16161C; --surface-2:#1F1F27;
    --border:#26262F; --border-hi:#333340;
    --text:#F5F5F7; --text-2:#A8A8B3; --text-3:#6E6E7A;
    --gold:#FFD200; --orange:#F87728; --green:#10B981; --red:#EF4444; --blue:#06B6D4;
    --purple:#8B5CF6; --pink:#EC4899; --teal:#14B8A6; --lime:#84CC16; --cyan:#22D3EE;
    --shadow:0 4px 24px rgba(0,0,0,0.5); --shadow-lg:0 24px 80px rgba(0,0,0,0.65);
    --panel-bg:rgba(22,22,28,0.72); --glass:rgba(255,255,255,0.03);
    --fs-base:15px; --fs-sm:0.82rem; --fs-xs:0.72rem; --fs-table:0.78rem;
    --fs-icon:1rem; --fs-icon-lg:1.15rem; --btn-xs-fs:0.75rem;
  }
  [data-theme="light"] {
    --bg:#F4F4F7; --bg-2:#FFFFFF; --surface:#FFFFFF; --surface-2:#F0F0F4;
    --border:#E2E2E8; --border-hi:#CFCFD8;
    --text:#0F0F14; --text-2:#4A4A56; --text-3:#84848F;
    --gold:#B45309; --orange:#C2410C; --green:#059669; --red:#DC2626; --blue:#0891B2;
    --purple:#7C3AED; --pink:#DB2777; --teal:#0D9488; --lime:#65A30D; --cyan:#06B6D4;
    --shadow:0 4px 24px rgba(15,15,20,0.08); --shadow-lg:0 24px 80px rgba(15,15,20,0.15);
    --panel-bg:rgba(255,255,255,0.88); --glass:rgba(0,0,0,0.03);
  }
  /* === РЕЖИМ ДЛЯ СЛАБОВИДЯЩИХ === */
  html[data-accessibility="on"] {
    --fs-base:26px; --fs-sm:1.15rem; --fs-xs:1.05rem; --fs-table:1.1rem;
    --fs-icon:1.5rem; --fs-icon-lg:1.65rem; --btn-xs-fs:1.05rem;
    --border-hi:#FFFFFF; --text-2:#F0F0F5; --text-3:#D8D8E2; --border:#4A4A56;
    --gold:#FFE44D; --orange:#FFA05A; --green:#4ADE80; --red:#FF6B6B;
  }
  html[data-accessibility="on"][data-theme="light"] {
    --border-hi:#000; --text-2:#0A0A0A; --text-3:#1F1F2A; --border:#222; --text:#000; --bg:#FFF;
    --gold:#7A3200; --orange:#8B2500; --green:#065F46; --red:#991B1B;
  }
  html[data-accessibility="on"] * {
    animation-duration:0.001s !important;
    transition-duration:0.05s !important;
    letter-spacing:0.01em;
    line-height:1.6;
  }
  html[data-accessibility="on"] body { font-weight:500; }
  html[data-accessibility="on"] .btn,
  html[data-accessibility="on"] button:not(.modal-close):not(.icon-btn) {
    min-height:52px !important;
    padding:14px 20px !important;
    font-size:1rem !important;
    border-width:2px !important;
  }
  html[data-accessibility="on"] input,
  html[data-accessibility="on"] select,
  html[data-accessibility="on"] textarea {
    min-height:52px !important;
    font-size:1.05rem !important;
    border-width:2px !important;
  }
  html[data-accessibility="on"] .icon-btn { width:52px !important; height:52px !important; }
  html[data-accessibility="on"] .class-chip { padding:12px 18px !important; }
  html[data-accessibility="on"] table.data { font-size:1rem; }
  html[data-accessibility="on"] table.data th { font-size:0.9rem; padding:16px 12px; }
  html[data-accessibility="on"] table.data td { padding:16px 12px; }
  html[data-accessibility="on"] .neuro-card,
  html[data-accessibility="on"] .component-card,
  html[data-accessibility="on"] .panel { border-width:2px; }
  html[data-accessibility="on"] .bottom-nav { height:88px; }
  html[data-accessibility="on"] .bottom-nav-item .bn-label { font-size:0.8rem; }
  html[data-accessibility="on"] .bottom-nav-item .bn-icon { font-size:1.7rem; }
  html[data-accessibility="on"] .neuro-panel,
  html[data-accessibility="on"] .unified-panel { border-width:3px; }

  * { box-sizing:border-box; margin:0; padding:0; }
  html { scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
  body {
    font-family:'Manrope',system-ui,sans-serif; background:var(--bg); color:var(--text);
    min-height:100vh; padding:20px; font-size:var(--fs-base); line-height:1.5;
    transition:background-color .5s,color .5s; overflow-x:hidden;
  }
  #auroraCanvas { position:fixed; inset:0; z-index:-1; pointer-events:none; opacity:.5; }
  html[data-accessibility="on"] #auroraCanvas { display:none; }
  #errBox { display:none; position:fixed; top:10px; left:50%; transform:translateX(-50%);
    background:#B01242; color:#fff; padding:12px 20px; border-radius:8px;
    font-family:monospace; font-size:.85rem; z-index:99999; max-width:90vw; }
  .container { max-width:1600px; margin:0 auto; position:relative; z-index:2; }

  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  @keyframes fadeInUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  @keyframes slideInRight{from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:translateX(0)}}
  @keyframes slideInLeft{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:translateX(0)}}
  @keyframes popIn{0%{opacity:0;transform:scale(.9)}60%{transform:scale(1.02)}100%{opacity:1;transform:scale(1)}}
  @keyframes pulseRing{0%{box-shadow:0 0 0 0 rgba(255,210,0,.6)}70%{box-shadow:0 0 0 20px rgba(255,210,0,0)}100%{box-shadow:0 0 0 0 rgba(255,210,0,0)}}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
  @keyframes gradShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  @keyframes typingDot{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-6px);opacity:1}}
  @keyframes morphBlob{0%,100%{border-radius:50%}25%{border-radius:60% 40% 55% 45%}50%{border-radius:45% 55% 40% 60%}75%{border-radius:55% 45% 60% 40%}}
  @keyframes avatarGlow{0%,100%{box-shadow:0 0 0 0 rgba(255,210,0,.4)}50%{box-shadow:0 0 24px 6px rgba(255,210,0,.5)}}
  @keyframes toastProgress{from{width:100%}to{width:0%}}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
  @keyframes onlinePulse{0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,.6)}70%{box-shadow:0 0 0 8px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
  @keyframes slideUp{from{transform:translateY(100%);opacity:0.6}to{transform:translateY(0);opacity:1}}
  @keyframes popStar{0%{transform:scale(0) rotate(0);opacity:1}100%{transform:scale(2) rotate(180deg);opacity:0}}
  @keyframes fall{from{transform:translateY(-20vh) rotate(0);opacity:1}to{transform:translateY(100vh) rotate(720deg);opacity:.2}}

  /* ============ AUTH ============ */
  .auth-screen { position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center;
    padding:16px; background:radial-gradient(circle at 30% 20%,rgba(255,210,0,.14) 0%,transparent 55%),
      radial-gradient(circle at 70% 80%,rgba(248,119,40,.1) 0%,transparent 55%),#0A0A0C;
    animation:fadeIn .4s; overflow-y:auto; }
  .auth-screen.hidden { display:none; }
  .auth-top-controls { position:fixed; top:16px; right:16px; display:flex; gap:8px; z-index:10; }
  .control-btn { background:var(--surface); border:1px solid var(--border-hi); color:var(--text);
    padding:8px 14px; border-radius:10px; font-size:.85rem; font-weight:600; cursor:pointer;
    display:flex; align-items:center; gap:6px; font-family:inherit; transition:all .3s; }
  [data-theme="dark"] .control-btn { background:rgba(22,22,28,.72); backdrop-filter:blur(20px); }
  [data-theme="light"] .control-btn { background:#FFF; color:#0F0F14; border-color:#CFCFD8; }
  .control-btn:hover { border-color:var(--gold); transform:translateY(-2px); }
  .control-btn.icon-only { padding:8px; width:38px; height:38px; justify-content:center; font-size:var(--fs-icon); }
  .control-btn.active { background:var(--gold); color:#0A0A0C; border-color:var(--gold); }

  .auth-card { width:100%; max-width:420px; background:rgba(16,16,20,.85); backdrop-filter:blur(40px) saturate(180%);
    border:1px solid rgba(255,255,255,.08); border-radius:18px; padding:28px 32px 24px;
    box-shadow:var(--shadow-lg); position:relative; animation:popIn .6s; overflow:hidden; margin:auto; }
  .auth-card::before { content:""; position:absolute; top:-2px; left:-2px; right:-2px; height:4px;
    background:linear-gradient(90deg,var(--gold),var(--orange),var(--gold)); background-size:200% 100%;
    border-radius:18px 18px 0 0; animation:gradShift 4s ease infinite; }
  .auth-logo-wrap { text-align:center; margin-bottom:16px; }
  .brand-logo-box { padding:12px 22px; background:#0A0A0C; border:2px solid var(--gold);
    border-radius:12px; display:inline-block; font-weight:800; color:var(--gold); font-size:1rem;
    box-shadow:0 0 30px rgba(255,210,0,.3); letter-spacing:.5px; }
  .auth-card h1 { font-size:1.25rem; font-weight:800; text-align:center; margin-bottom:4px; color:#F5F5F7; }
  .auth-card .subtitle { text-align:center; color:#6E6E7A; font-size:.78rem; margin-bottom:20px; }
  .tabs { display:flex; background:rgba(0,0,0,.3); border-radius:10px; padding:4px; margin-bottom:18px; border:1px solid #333340; }
  .tabs button { flex:1; padding:9px; background:transparent; border:none; color:#6E6E7A;
    font-weight:600; font-size:.85rem; border-radius:6px; cursor:pointer; font-family:inherit; transition:all .3s; }
  .tabs button.active { background:linear-gradient(135deg,var(--gold),#E5BD00); color:#0A0A0C; font-weight:700; }
  .form-group { margin-bottom:10px; }
  .form-group label { display:block; font-size:.76rem; font-weight:600; color:#A8A8B3; margin-bottom:5px; }
  .form-group input, .form-group select { width:100%; padding:10px 13px; background:rgba(0,0,0,.35);
    border:1px solid #333340; border-radius:8px; color:#F5F5F7; font-size:.9rem; font-family:inherit; transition:all .3s; }
  .form-group input:focus, .form-group select:focus { outline:none; border-color:var(--gold); box-shadow:0 0 0 3px rgba(255,210,0,.15); }
  .auth-submit { width:100%; padding:12px; background:linear-gradient(135deg,var(--gold),#E5BD00);
    color:#0A0A0C; border:none; border-radius:10px; font-weight:700; font-size:.9rem;
    cursor:pointer; font-family:inherit; margin-top:10px; transition:all .3s; }
  .auth-submit:hover { transform:translateY(-2px); box-shadow:0 10px 30px rgba(255,210,0,.4); }
  .auth-error { background:rgba(239,68,68,.15); border:1px solid rgba(239,68,68,.4); color:#FCA5A5;
    padding:9px 13px; border-radius:8px; font-size:.8rem; margin-bottom:12px; display:none; }
  .auth-error.show { display:block; }
  .auth-hint { text-align:center; font-size:.72rem; color:#6E6E7A; margin-top:14px; }
  
  /* === ГЛАЗИК НА ПАРОЛЕ === */
  .pwd-wrap { position:relative; }
  .pwd-wrap input { padding-right:46px !important; }
  .pwd-eye { position:absolute; right:8px; top:50%; transform:translateY(-50%);
    width:36px; height:36px; border:none; background:transparent; cursor:pointer;
    font-size:1.1rem; color:#A8A8B3; display:flex; align-items:center; justify-content:center;
    border-radius:8px; transition:all .2s; line-height:1; }
  .pwd-eye:hover { background:rgba(255,210,0,.15); color:var(--gold); }
  .pwd-eye:active { transform:translateY(-50%) scale(.9); }
  .pwd-eye.on { color:var(--gold); }
  
  /* === ЗАПОМНИТЬ МЕНЯ === */
  .remember-row { display:flex; align-items:center; justify-content:space-between;
    margin:12px 0 4px; font-size:.82rem; color:#A8A8B3; }
  .remember-row label { display:flex; align-items:center; gap:8px; cursor:pointer; user-select:none; }
  .remember-row input[type="checkbox"] { width:18px; height:18px; accent-color:var(--gold); cursor:pointer; }
  .remember-row .last-user { font-size:.72rem; color:#6E6E7A; }

  /* ============ APP ============ */
  .app { display:none; } .app.active { display:block; animation:fadeIn .4s; }
  .topbar { display:flex; justify-content:space-between; align-items:center; padding:16px 24px;
    background:var(--panel-bg); backdrop-filter:blur(24px) saturate(180%);
    border:1px solid rgba(255,255,255,.06); border-radius:16px; margin-bottom:24px;
    box-shadow:var(--shadow); gap:20px; flex-wrap:wrap; position:relative; }
  [data-theme="light"] .topbar { border-color:var(--border-hi); background:#FFF; }
  .topbar::after { content:""; position:absolute; bottom:-1px; left:20px; right:20px; height:1px;
    background:linear-gradient(90deg,transparent,var(--gold),transparent); opacity:.6; }
  .brand { display:flex; align-items:center; gap:14px; }
  .brand-logo { padding:8px 16px; background:#0A0A0C; border:2px solid var(--gold); border-radius:10px;
    font-weight:800; color:var(--gold); font-size:.9rem; letter-spacing:.5px; box-shadow:0 0 20px rgba(255,210,0,.25); }
  .brand-text h1 { font-size:1.05rem; font-weight:800; }
  .brand-text p { font-size:.7rem; color:var(--text-3); text-transform:uppercase; letter-spacing:.08em; }
  .topbar-right { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .topbar-controls { display:flex; gap:8px; align-items:center; padding-right:12px; border-right:1px solid var(--border); }
  .user-box { display:flex; align-items:center; gap:12px; padding:6px 14px 6px 6px; background:var(--glass);
    border:1px solid var(--border-hi); border-radius:26px; cursor:pointer; transition:all .3s; }
  .user-box:hover { border-color:var(--gold); transform:translateY(-2px); }
  .user-avatar { width:36px; height:36px; border-radius:50%;
    background:linear-gradient(135deg,var(--gold),var(--orange)); color:#0A0A0C;
    display:flex; align-items:center; justify-content:center; font-weight:800; font-size:.9rem;
    background-size:cover; background-position:center; overflow:hidden; }
  .user-avatar img { width:100%; height:100%; object-fit:cover; }
  .user-info strong { font-size:.85rem; display:block; }
  .user-info span { font-size:.7rem; color:var(--text-3); }
  .role-badge { display:inline-flex; align-items:center; gap:4px; padding:2px 8px;
    border-radius:10px; font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
  .role-admin { background:rgba(239,68,68,.15); color:#FCA5A5; border:1px solid rgba(239,68,68,.4); }
  .role-manager { background:rgba(255,210,0,.15); color:var(--gold); border:1px solid rgba(255,210,0,.4); }
  .role-buyer { background:rgba(16,185,129,.15); color:#6EE7B7; border:1px solid rgba(16,185,129,.4); }
  .role-engineer { background:rgba(139,92,246,.15); color:#C4B5FD; border:1px solid rgba(139,92,246,.4); }

  .online-chip { display:flex; align-items:center; gap:8px; padding:8px 14px;
    background:rgba(16,185,129,.12); border:1px solid rgba(16,185,129,.35);
    border-radius:20px; font-size:.8rem; font-weight:700; color:#6EE7B7; cursor:pointer; transition:all .3s; }
  .online-chip:hover { background:rgba(16,185,129,.2); transform:translateY(-2px); }
  .online-dot-pulse { width:8px; height:8px; border-radius:50%; background:#10B981; animation:onlinePulse 2s infinite; }
  .online-chip .count { color:#fff; font-family:'JetBrains Mono',monospace; }

  .icon-btn { width:40px; height:40px; background:var(--glass); border:1px solid var(--border-hi);
    border-radius:10px; color:var(--text-2); cursor:pointer; display:flex; align-items:center;
    justify-content:center; font-size:var(--fs-icon); position:relative; font-family:inherit;
    transition:all .3s; line-height:1; }
  .icon-btn:hover { background:rgba(255,210,0,.1); color:var(--gold); border-color:var(--gold); transform:translateY(-2px); }
  .icon-btn.active { background:var(--gold); color:#0A0A0C; }
  .count-badge { position:absolute; top:-4px; right:-4px; background:#B01242; color:#fff;
    min-width:18px; height:18px; border-radius:9px; font-size:.65rem; font-weight:700;
    display:flex; align-items:center; justify-content:center; padding:0 5px; }
  .count-badge:empty { display:none; }
  .btn { padding:10px 18px; border-radius:10px; font-weight:600; font-size:.85rem;
    display:inline-flex; align-items:center; gap:6px; background:linear-gradient(135deg,var(--gold),#E5BD00);
    color:#0A0A0C; border:none; cursor:pointer; font-family:inherit;
    box-shadow:0 4px 12px rgba(255,210,0,.3); transition:all .3s; line-height:1.2; }
  .btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(255,210,0,.45); }
  .btn:disabled { opacity:.5; cursor:not-allowed; transform:none !important; }
  .btn.secondary { background:var(--glass); color:var(--text-2); border:1px solid var(--border-hi); box-shadow:none; }
  .btn.secondary:hover { color:var(--text); border-color:var(--gold); }
  .btn.success { background:linear-gradient(135deg,#10B981,#059669); color:#fff; }
  .btn.danger { background:rgba(239,68,68,.15); color:#FCA5A5; border:1px solid rgba(239,68,68,.3); }
  .btn.neuro { background:linear-gradient(135deg,#8B5CF6,#EC4899); color:#fff; box-shadow:0 4px 12px rgba(139,92,246,.4); }
  .btn.eco { background:linear-gradient(135deg,#84CC16,#14B8A6); color:#0A0A0C; }
  .btn.game { background:linear-gradient(135deg,#F59E0B,#EF4444); color:#fff; box-shadow:0 4px 12px rgba(245,158,11,.4); }
  .btn-xs { padding:6px 10px; font-size:var(--btn-xs-fs); border-radius:8px;
    min-width:36px; min-height:32px; justify-content:center; line-height:1; flex-shrink:0; white-space:nowrap; }
  td .btn-xs { display:inline-flex; align-items:center; justify-content:center; vertical-align:middle; margin:2px 0; }

  .focus-banner { display:none; position:fixed; top:20px; left:50%; transform:translateX(-50%);
    background:linear-gradient(135deg,var(--gold),var(--orange)); color:#0A0A0C;
    padding:12px 24px; border-radius:30px; font-weight:700; font-size:.9rem;
    z-index:5000; box-shadow:0 10px 40px rgba(255,210,0,.5); align-items:center; gap:12px; }
  .focus-banner.show { display:flex; }
  .focus-banner button { background:#0A0A0C; color:var(--gold); border:none; padding:6px 14px;
    border-radius:20px; font-weight:700; font-size:.82rem; cursor:pointer; font-family:inherit; }

  .panel { background:var(--panel-bg); backdrop-filter:blur(24px) saturate(180%);
    border:1px solid rgba(255,255,255,.06); border-radius:16px; padding:24px; margin-bottom:20px;
    box-shadow:var(--shadow); animation:fadeInUp .4s; }
  [data-theme="light"] .panel { border-color:var(--border-hi); }
  .panel h2 { font-size:1.05rem; font-weight:700; display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .panel h2 .dot { width:6px; height:20px; border-radius:3px; background:linear-gradient(180deg,var(--gold),var(--orange)); }

  .neuro-panel { background:linear-gradient(135deg,rgba(139,92,246,.12),rgba(236,72,153,.08),rgba(6,182,212,.08));
    border:1px solid rgba(139,92,246,.35); border-radius:18px; padding:0; margin-bottom:20px;
    position:relative; overflow:hidden; backdrop-filter:blur(24px); animation:fadeInUp .4s; }
  .neuro-panel::before { content:""; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,#8B5CF6,#EC4899,#06B6D4,#8B5CF6); background-size:200% 100%;
    animation:gradShift 3s linear infinite; }
  .neuro-header { display:flex; justify-content:space-between; align-items:center;
    padding:22px 26px 14px; gap:16px; flex-wrap:wrap; }
  .neuro-title { display:flex; align-items:center; gap:12px; font-size:1.15rem; font-weight:800;
    background:linear-gradient(135deg,#8B5CF6,#EC4899); -webkit-background-clip:text; background-clip:text;
    -webkit-text-fill-color:transparent; }
  .neuro-title .icon { font-size:1.6rem; animation:bob 2s ease-in-out infinite; }
  .neuro-body { padding:0 26px 24px; }
  .neuro-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; }
  .neuro-card { background:var(--glass); border:1px solid var(--border-hi); border-radius:14px;
    padding:16px; transition:all .3s; cursor:pointer; position:relative; overflow:hidden; }
  .neuro-card:hover { border-color:var(--purple); transform:translateY(-3px); box-shadow:0 10px 30px rgba(139,92,246,.2); }
  .neuro-card .nc-icon { font-size:2rem; margin-bottom:8px; display:block; }
  .neuro-card .nc-title { font-weight:800; font-size:.9rem; margin-bottom:4px; }
  .neuro-card .nc-desc { font-size:.75rem; color:var(--text-3); line-height:1.4; }
