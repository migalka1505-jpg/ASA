  if (currentUser && currentUser.city) {
    var cd = CITIES.find(function(c) { return c.name === currentUser.city; });
    if (cd) adj = cd.deliveryAdj;
  }
  return Math.max(1, base + seasonal + adj);
}
function getDeliveryDate(vendor) { var d = new Date(); d.setDate(d.getDate() + getDeliveryDays(vendor)); return d; }
function fmtDate(d) { return d.toLocaleDateString("ru-RU", { day:"2-digit", month:"2-digit", year:"numeric" }); }
function getDeliveryRange(vendor) {
  var days = getDeliveryDays(vendor);
