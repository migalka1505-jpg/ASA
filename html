var gameState = {
  active: false, score: 0, timeLeft: 30, combo: 1, streak: 0,
  spawnInterval: null, timerInterval: null, items: []
};
var GAME_ICONS = ["📡","⚙️","🔌","🌀","🖥","🔋","🔧","🧪","📶","🌡","💧","📊"];
var GAME_RARE = "💎";
var GAME_BOMB = "💣";

function openGame() {
  $("gameModal").classList.add("active");
  resetGameUI();
  updateMobileCloseBtn();
}
function closeGame() {
  stopGame();
  $("gameModal").classList.remove("active");
  updateMobileCloseBtn();
}
function resetGameUI() {
  var sc = $("gameScreen");
  // Удаляем все объекты
  sc.querySelectorAll(".game-item, .game-pop").forEach(function(el) { el.remove(); });
  $("gameStart").style.display = "flex";
  var over = sc.querySelector(".game-over"); if (over) over.remove();
  $("gameTimer").textContent = "30";
  $("gameScore").textContent = "0";
  $("gameCombo").textContent = "1";
  gameState.score = 0; gameState.timeLeft = 30; gameState.combo = 1; gameState.streak = 0;
}
function startGame() {
  $("gameStart").style.display = "none";
  var sc = $("gameScreen");
  var over = sc.querySelector(".game-over"); if (over) over.remove();
  gameState.active = true;
  gameState.score = 0; gameState.timeLeft = 30; gameState.combo = 1; gameState.streak = 0;
  $("gameScore").textContent = "0";
  $("gameTimer").textContent = "30";
  $("gameCombo").textContent = "1";
  // Спавн
  gameState.spawnInterval = setInterval(spawnGameItem, 550);
  spawnGameItem();
  // Таймер
  gameState.timerInterval = setInterval(function() {
    gameState.timeLeft--;
    $("gameTimer").textContent = gameState.timeLeft;
    if (gameState.timeLeft <= 0) endGame();
  }, 1000);
}
function stopGame() {
  gameState.active = false;
  if (gameState.spawnInterval) { clearInterval(gameState.spawnInterval); gameState.spawnInterval = null; }
  if (gameState.timerInterval) { clearInterval(gameState.timerInterval); gameState.timerInterval = null; }
}
function spawnGameItem() {
  if (!gameState.active) return;
  var sc = $("gameScreen");
  if (!sc) return;
  var rect = sc.getBoundingClientRect();
  var isBomb = Math.random() < 0.18;
  var isRare = !isBomb && Math.random() < 0.12;
  var icon = isBomb ? GAME_BOMB : (isRare ? GAME_RARE : GAME_ICONS[Math.floor(Math.random() * GAME_ICONS.length)]);
  var el = document.createElement("div");
  el.className = "game-item" + (isBomb ? " bomb" : "") + (isRare ? " rare" : "");
  el.textContent = icon;
  el.dataset.type = isBomb ? "bomb" : (isRare ? "rare" : "normal");
  el.dataset.x = Math.random() * (rect.width - 80) + 20;
  el.dataset.y = -60;
  el.style.left = el.dataset.x + "px";
  el.style.top = "0px";
  el.addEventListener("click", function(e) { e.stopPropagation(); catchGameItem(el); });
  el.addEventListener("touchstart", function(e) { e.stopPropagation(); e.preventDefault(); catchGameItem(el); }, { passive: false });
  sc.appendChild(el);
  var speed = 1.6 + Math.random() * 1.4 + (30 - gameState.timeLeft) * 0.04;
  var iv = setInterval(function() {
    if (!gameState.active || !el.parentNode) { clearInterval(iv); return; }
    var y = parseFloat(el.dataset.y) + speed;
    el.dataset.y = y;
    el.style.top = y + "px";
    if (y > rect.height) {
      clearInterval(iv);
      el.remove();
      if (el.dataset.type !== "bomb") {
        gameState.streak = 0;
        gameState.combo = 1;
        var gc = $("gameCombo"); if (gc) gc.textContent = "1";
      }
    }
  }, 16);
  el.dataset.ivId = iv;
}
function catchGameItem(el) {
  if (!gameState.active) return;
  var rect = $("gameScreen").getBoundingClientRect();
  var x = parseFloat(el.dataset.x) + 20;
  var y = parseFloat(el.dataset.y) + 20;
  var type = el.dataset.type;
  var delta = 0;
  var color = "#FFD200";
  var text = "";
  if (type === "bomb") {
    delta = -30;
    color = "#EF4444";
    text = "💥 -30";
    gameState.streak = 0;
    gameState.combo = 1;
    var gs = $("gameScreen");
    gs.style.animation = "shake .3s";
    setTimeout(function() { gs.style.animation = ""; }, 350);
  } else if (type === "rare") {
    delta = 50 * gameState.combo;
    color = "#8B5CF6";
    text = "💎 +" + delta;
    gameState.streak++;
  } else {
    delta = 10 * gameState.combo;
    color = "#10B981";
    text = "+" + delta;
    gameState.streak++;
  }
  gameState.score = Math.max(0, gameState.score + delta);
  if (gameState.streak >= 5 && gameState.combo < 5) {
    gameState.combo++;
    var gc = $("gameCombo"); if (gc) gc.textContent = gameState.combo;
  }
  $("gameScore").textContent = gameState.score;
  // Анимация +/- 
  var pop = document.createElement("div");
  pop.className = "game-pop";
  pop.textContent = text;
  pop.style.color = color;
  pop.style.left = x + "px";
  pop.style.top = y + "px";
  $("gameScreen").appendChild(pop);
  setTimeout(function() { pop.remove(); }, 600);
  el.style.transform = "scale(1.6)";
  el.style.opacity = "0";
  if (el.dataset.ivId) clearInterval(parseInt(el.dataset.ivId));
  setTimeout(function() { el.remove(); }, 100);
  // Вибрация
  if (navigator.vibrate) navigator.vibrate(type === "bomb" ? [50,30,50] : 10);
}
function endGame() {
  stopGame();
  // Убираем все объекты
  $("gameScreen").querySelectorAll(".game-item").forEach(function(el) { el.remove(); });
  var sc = $("gameScreen");
  var finalScore = gameState.score;
