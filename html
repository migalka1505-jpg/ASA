function removeFromCart(id) { for (var i = 0; i < cart.length; i++) if (cart[i].id === id) { cart.splice(i,1); break; } updateBadges(); autoSave(); renderDashboard(); render(); }
function setCartQty(id, qty) {
  for (var i = 0; i < cart.length; i++) if (cart[i].id === id) {
    if (qty <= 0) { removeFromCart(id); return; }
    cart[i].qty = qty; break;
  }
  updateBadges(); autoSave(); renderDashboard();
}
function toggleFavorite(id) {
