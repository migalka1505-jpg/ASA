function extractPriceMax(q) {
  var m1 = q.match(/(?:до|дешевле|макс|max|<|не дороже)\s*(\d[\d\s]*)\s*(?:₽|руб|рубл)?/i);
  if (m1) return parseInt(m1[1].replace(/\s/g, ""), 10);
  var m2 = q.match(/(\d[\d\s]{3,})\s*(?:₽|руб)/i);
  if (m2) return parseInt(m2[1].replace(/\s/g, ""), 10);
  return null;
}
function extractDeliveryDays(q) {
  var m = q.match(/(?:за|до|в течение|max|макс)\s*(\d+)\s*(?:дн|день|дней|day)/i);
  if (m) return parseInt(m[1], 10);
  return null;
}
function extractCategories(q) {
  var cats = ["Датчик","Контроллер","Модуль","Привод","Интерфейс","Питание","Арматура","Аналитика","Связь"];
  var subs = ["давлени","температур","расход","уровн","вибрац","газоанализ","влажност","клапан","задвижк","регулятор","ибп","плк"];
  var vendors = Object.keys(vendorDatabase);
  var r = { categories: [], subs: [], vendors: [], country: null, stock: false, eco: false, import: false };
  cats.forEach(function(c) { if (q.indexOf(c.toLowerCase()) >= 0) r.categories.push(c); });
  subs.forEach(function(s) { if (q.indexOf(s) >= 0) r.subs.push(s); });
  vendors.forEach(function(v) { if (q.indexOf(v.toLowerCase()) >= 0) r.vendors.push(v); });
  if (/(российск|рф|отечественн|ru\b)/i.test(q)) r.country = "RU";
  if (/(европ|eu\b|немецк|siemens|abb)/i.test(q)) r.country = "EU";
  if (/(китайск|cn\b|china)/i.test(q)) r.country = "CN";
  if (/(в наличии|есть на складе|stock)/i.test(q)) r.stock = true;
  if (/(эко|eco|co2|углерод|зелен)/i.test(q)) r.eco = true;
  if (/(импортозам|локализац|отечественн)/i.test(q)) r.import = true;
  return r;
}
function smartSearchAI(query) {
  var q = query.toLowerCase();
  var priceMax = extractPriceMax(q);
  var dmax = extractDeliveryDays(q);
  var cat = extractCategories(q);
  var filtered = components.filter(function(c) {
    if (priceMax && c.price > priceMax) return false;
    if (dmax && getDeliveryDays(c.vendor) > dmax) return false;
    if (cat.country && (!vendorDatabase[c.vendor] || vendorDatabase[c.vendor].country !== cat.country)) return false;
    if (cat.stock && !c.stock) return false;
    if (cat.categories.length && cat.categories.indexOf(c.category) < 0) return false;
    if (cat.vendors.length && cat.vendors.indexOf(c.vendor) < 0) return false;
    if (cat.subs.length) {
      var hay = (c.subcategory + " " + c.name).toLowerCase();
      var ok = cat.subs.some(function(s) { return hay.indexOf(s) >= 0; });
      if (!ok) return false;
    }
    if (cat.eco && getComponentEco(c) > 5) return false;
    if (cat.import && getComponentImportIndex(c) < 80) return false;
    return true;
  });
  // Если пусто — ослабляем: только поисковые слова
  if (!filtered.length) {
    var terms = q.split(/\s+/).filter(function(w) { return w.length > 2; });
    filtered = components.filter(function(c) {
      var hay = (c.name + " " + c.category + " " + c.subcategory + " " + c.vendor + " " + c.protocol).toLowerCase();
      return terms.some(function(w) { return hay.indexOf(w) >= 0; });
    });
  }
  return { items: filtered, priceMax: priceMax, dmax: dmax, cat: cat };
}
