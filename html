/* ============ АНАЛОГИ ============ */
function showAnalogs(id) {
  var target = findComponentById(id); if (!target) return;
  var analogs = [];
  for (var i = 0; i < components.length; i++) {
    var c = components[i];
    if (c.id === target.id || c.category !== target.category) continue;
    var s = 50;
    if (c.protocol === target.protocol && c.protocol) s += 20;
    if (c.tempMin <= target.tempMin) s += 10;
    if (c.ip >= target.ip) s += 10;
    if (c.stock) s += 5;
    if (c.price <= target.price) s += 5;
    analogs.push({ c:c, s: Math.min(s, 100) });
  }
  analogs.sort(function(a,b) { return b.s - a.s; });
  analogs = analogs.slice(0, 5);
  $("modalTitle").innerHTML = "🔄 Аналоги: " + escapeHtml(target.name);
  if (!analogs.length) $("analogContent").innerHTML = '<div style="text-align:center;padding:40px;">Нет аналогов</div>';
  else {
    var html = "";
    analogs.forEach(function(a) {
      var cc = a.c, cls = a.s>=85?"best":a.s>=70?"good":"";
      var lbl = a.s>=85?"Отличная замена":a.s>=70?"Хорошая замена":"Возможная";
      var r = getDeliveryRange(cc.vendor);
      html += '<div class="analog-card '+cls+'">';
      html += '<div class="analog-name">'+getComponentImage(cc)+' '+escapeHtml(cc.name)+'</div>';
      html += '<div class="analog-info"><span>'+cc.category+'</span><span>'+(cc.protocol||"—")+'</span><span>'+fmtPrice(cc.price)+'</span><span>🚚 '+r.min+'–'+r.max+'</span></div>';
      html += '<div class="similarity-bar"><div class="similarity-fill" style="width:'+a.s+'%"></div></div>';
      html += '<div style="font-size:.75rem;display:flex;justify-content:space-between;"><span>'+lbl+'</span><strong style="color:var(--gold);">'+a.s+'%</strong></div>';
      html += '<div style="margin-top:10px;display:flex;gap:6px;">';
      html += '<button class="btn btn-xs" onclick="closeAnalogModal();openDetailModal('+cc.id+')">👁 Подробно</button>';
      if (hasPerm("createOrders")) html += '<button class="btn btn-xs success" onclick="addToCart('+cc.id+')"><span>🛒</span></button>';
      html += '</div></div>';
    });
    $("analogContent").innerHTML = html;
  }
  $("analogModal").classList.add("active");
  updateMobileCloseBtn();
}
function closeAnalogModal() { $("analogModal").classList.remove("active"); updateMobileCloseBtn(); }

