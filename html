    '<div style="display:flex;gap:10px;margin-top:10px;">' +
    '<button class="btn game" onclick="startGame()" style="padding:12px 28px;">🔄 Играть снова</button>' +
    '<button class="btn secondary" onclick="closeGame()" style="padding:12px 28px;">✖ Закрыть</button>' +
