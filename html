var ONLINE_KEY = "asutp_online_2026", ONLINE_TIMEOUT = 60000, onlineHb = null;
function getOnlineRegistry() {
  var r = safeGet(ONLINE_KEY) || {}; var now = Date.now(); var clean = {};
  for (var e in r) if (r[e] && (now - r[e].lastSeen) < ONLINE_TIMEOUT) clean[e] = r[e];
  return clean;
}
