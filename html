function openCompareModal() {
  if (compareList.length < 2) return;
  var items = compareList.map(findComponentById).filter(Boolean);
  var rows = [
    { l:"Изображение", r:function(c){ return '<div style="font-size:2rem;text-align:center;">'+getComponentImage(c)+'</div>'; } },
    { l:"Наименование", r:function(c){ return "<strong>"+escapeHtml(c.name)+"</strong>"; } },
    { l:"Категория", r:function(c){ return c.category; } },
    { l:"Подкатегория", r:function(c){ return c.subcategory; } },
    { l:"Производитель", r:function(c){ return escapeHtml(c.vendor); } },
    { l:"Страна", r:function(c){ var v = vendorDatabase[c.vendor]; return v ? ({RU:"🇷🇺 Россия",EU:"🇪🇺 Европа",US:"🇺🇸 США",JP:"🇯🇵 Япония",CN:"🇨🇳 Китай"})[v.country] : "—"; } },
    { l:"Протокол", r:function(c){ return c.protocol||"—"; } },
    { l:"Цена, ₽", r:function(c){ return fmtPrice(c.price); }, best:"min", v:function(c){ return c.price; } },
    { l:"Доставка, дн.", r:function(c){ return getDeliveryDays(c.vendor); }, best:"min", v:function(c){ return getDeliveryDays(c.vendor); } },
    { l:"Наличие", r:function(c){ return c.stock?t("inStock"):t("onOrder"); } },
    { l:"Мин. темп., °C", r:function(c){ return c.tempMin; }, best:"min", v:function(c){ return c.tempMin; } },
    { l:"IP", r:function(c){ return "IP"+c.ip; }, best:"max", v:function(c){ return c.ip; } },
    { l:"Диапазон", r:function(c){ return c.range; } },
    { l:"Погрешность", r:function(c){ return c.accuracy; } },
    { l:"Срок службы", r:function(c){ return c.lifetime+" лет"; } },
    { l:"Надёжность", r:function(c){ var v = vendorDatabase[c.vendor]; return v ? v.reliability+"/100" : "—"; }, best:"max", v:function(c){ return (vendorDatabase[c.vendor]||{}).reliability; } },
    { l:"🌱 CO₂, кг", r:function(c){ return getComponentEco(c)+" кг"; }, best:"min", v:function(c){ return getComponentEco(c); } },
    { l:"🛡 Импортозам., %", r:function(c){ return getComponentImportIndex(c)+"%"; }, best:"max", v:function(c){ return getComponentImportIndex(c); } },
    { l:"⚡ Класс энергии", r:function(c){ return getComponentEnergyClass(c); } },
    { l:"🧠 Нейро-скор", r:function(c){ return getNeuralScore(c)+"/100"; }, best:"max", v:function(c){ return getNeuralScore(c); } },
    { l:"Рейтинг", r:function(c){ return calculateScore(c).total+"/100"; }, best:"max", v:function(c){ return calculateScore(c).total; } }
  ];
  var html = '<div class="compare-wrap"><table class="compare-table"><thead><tr><th>Параметр</th>';
  items.forEach(function(it) { html += "<th>"+escapeHtml(it.name)+"</th>"; });
  html += "</tr></thead><tbody>";
  rows.forEach(function(row) {
    html += "<tr><td>"+row.l+"</td>";
    var bestVal = null;
    if (row.v) {
      var vals = items.map(row.v);
      if (row.best === "min") bestVal = Math.min.apply(null, vals);
      else if (row.best === "max") bestVal = Math.max.apply(null, vals);
    }
    items.forEach(function(it) {
      var cls = "";
      if (row.v && bestVal !== null) {
        var v = row.v(it);
        var cnt = 0;
        items.forEach(function(x) { if (row.v(x) === bestVal) cnt++; });
        if (v === bestVal && cnt < items.length) cls = "cell-best";
      }
      html += '<td class="'+cls+'">'+row.r(it)+"</td>";
    });
    html += "</tr>";
  });
  html += "</tbody></table></div>";
  $("compareContent").innerHTML = html;
  $("compareModal").classList.add("active");
  updateMobileCloseBtn();
}
function closeCompareModal() { $("compareModal").classList.remove("active"); updateMobileCloseBtn(); }

