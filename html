var _arScale = 1, _arDrag = { active: false, x: 0, y: 0 };
function scaleARModel(m) {
  _arScale = Math.max(0.3, Math.min(3, _arScale * m));
  var el = $("arModel"); if (el) el.style.transform = "scale(" + _arScale + ")";
}
function resetARModel() {
  _arScale = 1;
  var el = $("arModel");
  if (el) { el.style.transform = ""; el.style.marginLeft = ""; el.style.marginTop = ""; }
}
function setupARDrag() {
  var el = $("arModel"); if (!el) return;
  var start = function(e) {
    _arDrag.active = true;
    var t = e.touches ? e.touches[0] : e;
    _arDrag.x = t.clientX; _arDrag.y = t.clientY;
  };
  var move = function(e) {
    if (!_arDrag.active) return;
    var t = e.touches ? e.touches[0] : e;
    var dx = t.clientX - _arDrag.x, dy = t.clientY - _arDrag.y;
    var curX = parseFloat(el.dataset.mx || 0) + dx;
    var curY = parseFloat(el.dataset.my || 0) + dy;
    el.dataset.mx = curX; el.dataset.my = curY;
    el.style.marginLeft = curX + "px";
    el.style.marginTop = curY + "px";
    _arDrag.x = t.clientX; _arDrag.y = t.clientY;
    if (e.cancelable) e.preventDefault();
  };
  var end = function() { _arDrag.active = false; };
  el.addEventListener("mousedown", start);
  el.addEventListener("touchstart", start, { passive: true });
  document.addEventListener("mousemove", move);
  document.addEventListener("touchmove", move, { passive: false });
  document.addEventListener("mouseup", end);
  document.addEventListener("touchend", end);
}
function closeArModal() {
  var v = $("arVideo");
  if (v && v.srcObject) { v.srcObject.getTracks().forEach(function(t) { t.stop(); }); }
